# ---- Server-only (never exposed to the browser; no VITE_ prefix) ----
# Long-lived key from Google AI Studio. Used only to mint ephemeral Live tokens and for the revision-point text model.
GEMINI_API_KEY=
# Live model (check https://ai.google.dev/gemini-api/docs/live for current names)
GEMINI_LIVE_MODEL=gemini-3.8-live
# Text model used for the revision point (structured JSON output)
GEMINI_TEXT_MODEL=gemini-3-flash
# Firebase Admin. With emulators, only the project id is needed.
FIREBASE_PROJECT_ID=demo-eye-academy
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# For a real project instead: path to a service-account JSON (and remove the *_EMULATOR_HOST lines)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---- Browser (public Firebase web config; safe to expose) ----
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-eye-academy
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-eye-academy.firebaseapp.com
